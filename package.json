{
  "name": "portfolio-mame-fatou-faye",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.14.0",
  "type": "module",
  "description": "Portfolio professionnel de Mame Fatou Faye, développeuse logiciel et web à Dakar.",
  "scripts": {
    "assets:generate": "node scripts/generate-assets.mjs",
    "audit:responsive": "node scripts/check-responsive.mjs",
