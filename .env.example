# URL publique absolue, avec ou sans barre oblique finale.
# Utilisée au build pour l'URL canonique et les métadonnées de partage.
VITE_SITE_URL=https://portfolio-mami.vercel.app/

# Facultatif : endpoint HTTPS acceptant le formulaire de contact en JSON.
# Toute variable VITE_* est publique dans le bundle : ne placez aucun secret ici.
VITE_CONTACT_ENDPOINT=
